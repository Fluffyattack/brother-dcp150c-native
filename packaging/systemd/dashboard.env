# Local dashboard settings. Existing settings are preserved during installation.
# Read model-specific ink levels using the validated status exchange.
# It also requires this project's CUPS backend, an idle device and the shared lock.
DCP150C_MODEL_STATUS=1
# Browser actions require a password set with:
# sudo -u root env PYTHONPATH=/usr/lib/dcp150c-native python3 -m dcp150c.access_control
# The password command grants its hash file to the dcp150c service group (0640).
